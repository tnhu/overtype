{
  "name": "v-markdown-input",
  "version": "0.1.0",
  "description": "A standalone web component markdown editor derived from OverType, preserving the original MIT license and credits.",
  "type": "module",
  "main": "dist/v-markdown-input.cjs",
  "module": "dist/v-markdown-input.esm.js",
  "browser": "dist/v-markdown-input.min.js",
  "types": "dist/v-markdown-input.d.ts",
  "exports": {
    ".": {
      "types": "./dist/v-markdown-input.d.ts",
      "import": "./dist/v-markdown-input.esm.js",
      "require": "./dist/v-markdown-input.cjs",
      "browser": "./dist/v-markdown-input.min.js"
    },
    "./webcomponent": {
      "import": "./dist/v-markdown-input-webcomponent.esm.js",
      "browser": "./dist/v-markdown-input-webcomponent.min.js"
    }
  },
  "scripts": {
    "build": "node scripts/build.js",
    "dev": "http-server demo -p 8090 -c-1",
    "serve": "http-server demo -p 8090 -c-1"
  },
  "keywords": [
    "markdown",
    "editor",
    "wysiwyg",
    "web-components",
    "custom-elements",
    "shadow-dom",
    "shiki",
    "markdown-editor"
  ],
  "author": "David Miranda",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/panphora/overtype.git"
  },
  "homepage": "https://github.com/panphora/overtype",
  "dependencies": {
    "@floating-ui/dom": "^1.7.4",
    "markdown-actions": "^1.1.2"
  },
  "devDependencies": {
    "esbuild": "^0.19.0",
    "http-server": "^14.1.1"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "credits": {
    "derivedFrom": "OverType",
    "author": "David Miranda",
    "license": "MIT",
    "projectUrl": "https://github.com/panphora/overtype"
  }
}
